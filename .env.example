# Copy to .env for local runs. `netlify dev` loads this file into the server,
# and a variable set in your shell wins over it. Never commit .env.
#
# Use a separate Slack app for local development: an app sends its events to
# one Request URL, so pointing your deployed app at a local URL would take it
# offline.
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_SIGNING_SECRET=...
